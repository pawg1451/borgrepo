{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["*.mjs", "*.ts", "**/*.mjs", "**/*.ts"]
}
